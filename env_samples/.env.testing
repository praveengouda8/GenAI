# -----------------------------------------------------------------------------
# Testing Environment Variables
# -----------------------------------------------------------------------------

# Groq API Key for automated tests/CI (or mock key if tests don't make real requests)
GROQ_API_KEY=mock_or_test_groq_api_key_here

# Groq Model (options: qwen/qwen3.6-27b, llama-3.3-70b-versatile, etc.)
GROQ_MODEL=qwen/qwen3.6-27b
